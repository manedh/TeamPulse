{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "functions": {
    "api/teampulse.js": {
      "maxDuration": 60
    },
    "api/password-recovery-mail.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/reset-password",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
